STREAMVAULT_DATA_DIR=./data
# Set true when served through HTTPS. Leave false for local HTTP development.
STREAMVAULT_SECURE_COOKIE=false
# Optional: absolute roots allowed in the administrator's folder field (semicolon separated).
STREAMVAULT_ALLOWED_ROOTS=
# Optional Nginx internal redirect prefix, for efficient protected media delivery.
STREAMVAULT_ACCEL_PREFIX=

# Exact browser-visible origin when using an HTTPS reverse proxy.
STREAMVAULT_PUBLIC_ORIGIN=

# Native folder dialog for local desktop access; false uses the in-app server folder browser.
STREAMVAULT_NATIVE_FOLDER_PICKER=true
