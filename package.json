{
  "name": "streamvault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "scan": "node --import tsx scripts/scan.ts",
    "demo": "node --import tsx scripts/demo.ts",
    "compat": "node --import tsx scripts/compat.ts",
    "backup": "node --import tsx scripts/backup.ts",
    "format": "prettier --write src scripts tests next.config.ts tsconfig.json components.json package.json compose.yaml pnpm-workspace.yaml postcss.config.mjs",
    "format:check": "prettier --check src scripts tests next.config.ts tsconfig.json components.json package.json compose.yaml pnpm-workspace.yaml postcss.config.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-slot": "1.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.52.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.19.0"
}
