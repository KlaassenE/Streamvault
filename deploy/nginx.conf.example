# Include within an existing HTTPS server block. Replace the proxy target as needed.
# Set STREAMVAULT_PUBLIC_ORIGIN to the exact public https:// hostname and port.
# Set STREAMVAULT_SECURE_COOKIE=true. This example keeps protected media in Node.
location / {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_buffering off;
    proxy_read_timeout 300s;
    client_max_body_size 2m;
}
